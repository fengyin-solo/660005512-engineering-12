# 后端本地联调配置示例
# 用法: cp .env.example .env (Windows: copy .env.example .env),再按需修改
# 读取规则: 已存在的环境变量优先,其次 .env,最后使用代码内默认值

# 后端监听地址与端口(行情 WebSocket 与回测 HTTP 接口共用)
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# 允许跨域的前端来源(逗号分隔);前端 dev server 地址必须在列表内
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
