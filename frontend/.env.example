# 前端本地联调配置示例
# 用法: cp .env.example .env (Windows: copy .env.example .env),再按需修改
# Vite 只向客户端暴露 VITE_ 开头的变量;修改后需重启 dev server

# 前端 dev server 监听端口(页面访问端口)
VITE_DEV_PORT=3000

# 后端地址与端口:开发模式下 Vite 会把 /api 与 /ws 代理到这里
VITE_BACKEND_HOST=127.0.0.1
VITE_BACKEND_PORT=8000

# 浏览器访问行情/回测接口的基址。
# 留空(默认)即走同源相对路径,由 Vite 代理转发到上面的后端,无需关心浏览器所在主机;
# 只有在直接连远端后端(如联调环境)时才填完整地址:
#   VITE_API_BASE_URL=http://127.0.0.1:8000
#   VITE_WS_BASE_URL=ws://127.0.0.1:8000
VITE_API_BASE_URL=
VITE_WS_BASE_URL=
